{
  "name": "agent-teams-frontend-app",
  "version": "0.0.3-dev.0",
  "description": "Agent Teams desktop application",
  "author": "Agent Teams contributors",
  "private": true,
  "type": "module",
  "main": "dist-desktop/desktop/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && npm run desktop:build && vite build && npm run build:legacy",
    "build:legacy": "node ../legacy/build.mjs",
    "desktop:build": "tsc -p tsconfig.desktop.json",
    "desktop:dev": "npm run desktop:build && electron dist-desktop/desktop/main.js",
    "desktop:release:prepare": "npm run typecheck && npm run desktop:build && vite build && npm run build:legacy && node dist-desktop/desktop/buildBackend.cjs",
    "desktop:package": "npm run desktop:release:prepare && electron-builder --config electron-builder.yml --win --dir",
    "desktop:dist": "npm run desktop:release:prepare && electron-builder --config electron-builder.yml --win nsis",
    "desktop:release": "npm run desktop:release:prepare && electron-builder --config electron-builder.yml --win dir nsis",
    "desktop:smoke": "playwright test -c playwright.config.ts --project=chromium browser-tests/desktop-smoke.spec.ts",
    "desktop:smoke:packaged": "playwright test -c playwright.config.ts --project=chromium browser-tests/desktop-smoke.spec.ts --grep \"packaged distribution\"",
    "desktop:verify": "npm run test -- desktopPackaging.test.ts desktopBackendPlan.test.ts desktopSecurity.test.ts && npm run desktop:release && npm run desktop:smoke",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.desktop.json --noEmit",
    "lint": "tsc --noEmit --pretty false && tsc -p tsconfig.desktop.json --noEmit --pretty false",
    "test": "vitest run",
    "test:browser": "playwright test -c playwright.config.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ant-design/x": "^1.6.1",
    "@tanstack/react-query": "^5.100.14",
    "@tanstack/react-virtual": "^3.13.13",
    "antd": "^5.20.3",
    "hast-util-to-text": "^4.0.2",
    "highlight.js": "^11.11.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.5.0",
    "electron-builder": "26.0.12",
    "jsdom": "^27.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.3",
    "vitest": "^4.1.7"
  }
}
